APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco — schema portavel, sem recurso especifico de dialeto (Artigo IX).
#   dev........: sqlite (arquivo, zero setup)
#   testes.....: sqlite :memory: (definido em phpunit.xml, nao aqui)
#   producao...: mysql (Hostinger compartilhada nao oferece PostgreSQL)
DB_CONNECTION=sqlite

# Producao (Hostinger).
#
# ATENCAO: a Hostinger entrega MariaDB, nao MySQL. O Laravel 11+ tem driver
# DEDICADO para MariaDB — use `mariadb`, nao `mysql`. O driver mysql funciona
# na maioria dos casos, mas trata versao e recursos de forma diferente.
#
# Verificado em 04/08/2026: MariaDB 11.8.8, migrations rodam limpas.
#
# DB_CONNECTION=mariadb
# DB_HOST=srvXXX.hstgr.io
# DB_PORT=3306
# DB_DATABASE=uXXXXXXXXX_picogli
# DB_USERNAME=uXXXXXXXXX_picogli_adm
# DB_PASSWORD=
#
# NUNCA aponte a suite de testes para o banco de producao: `RefreshDatabase`
# derruba e recria todas as tabelas. Crie um banco separado para isso.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Fila — importacao NUNCA roda na request (NFR-002): ~4 mil inserts nao cabem
# no timeout de hospedagem compartilhada.
#   dev........: sync (executa na hora, facilita debug)
#   producao...: database + cron, porque compartilhada nao roda worker daemon:
#     * * * * * cd /home/USER/picogli && php artisan queue:work --stop-when-empty --max-time=55 >> /dev/null 2>&1
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# PicoGli
# ─────────────────────────────────────────────────────────────

# Fuso padrao sugerido no upload de um export. O CSV do CareLink NAO carrega
# fuso (§A5) — os timestamps sao hora local de parede do dispositivo. Errar
# isto desloca todo insight de horario mantendo os numeros plausiveis.
PICOGLI_DEFAULT_TIMEZONE=America/Sao_Paulo

# Gemini — usado apenas nas fases 5 e 6 (narrativa e chat).
# Artigo X: nao implementar IA antes da fase 4 estar concluida e testada.
# Artigo VII: nenhum payload contem nome, serial, DOB nem o arquivo bruto.
GEMINI_API_KEY=
#
# Nao existe GEMINI_MODEL: a fase 5 usa uma CADEIA de modelos, declarada em
# config/ai.php (model_chain), ordenada por qualidade. Uma variavel de modelo
# unico daria a impressao de configurar algo que ela nao configura mais.
